# Общие секреты с Next.js
DATABASE_CONNECTION_STRING=postgresql://user:password@host:5432/postgres
JWT_SECRET_KEY=длинная-случайная-строка
TEXT_SERVICE_TOKEN=длинная-случайная-строка
TEXT_SERVICE_JWT_SECRET=длинная-случайная-строка

# LLM по умолчанию
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini

# Секрет шифрования ключей пользователей. Только в сервисе.
LLM_SETTINGS_SECRET=длинная-случайная-строка
# Старый секрет для миграции ключей v1 из Next. После миграции можно убрать.
LLM_LEGACY_SECRET=длинная-случайная-строка

# Адреса
TEXT_SERVICE_HOST=127.0.0.1
TEXT_SERVICE_PORT=8000
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Лимиты
MAX_UPLOAD_BYTES=31457280
MAX_UPLOAD_TEXT=2000000
MAX_TWO_BOOKS_BYTES=4194304
MAX_TWO_BOOKS_PAGES=2000
MAX_TWO_BOOKS_TOKENS=600000
MAX_TRANSLATE_CHARS=200000
WORDS_PER_MINUTE=75
CHAT_CHUNK_WORDS=500
CHAT_MAX_TOKENS=3000
TRANSLATE_CONCURRENCY=3
